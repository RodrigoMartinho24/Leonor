{
  "name": "leonor",
  "version": "0.0.5",
  "main": "dist-electron/electron/main.js",
  "build": {
    "appId": "leonor",
    "productName": "Leonor",
    "publish": [
      {
        "provider": "github",
        "owner": "RodrigoMartinho24",
        "repo": "Leonor"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "clean:release": "rimraf release",
    "copy:migrations": "copyfiles -u 2 \"electron/database/migrations/**/*\" dist-electron/electron/database",
    "electron:build": "tsc -p tsconfig.electron.json && npm run copy:migrations",
    "electron": "electron .",
    "dev": "concurrently \"ng serve\" \"wait-on http://localhost:4200 && npm run electron:build && electron .\"",
    "build:angular": "ng build --configuration production --base-href ./",
    "build:electron": "tsc -p tsconfig.electron.json && npm run copy:migrations",
    "dist": "npm run clean:release && npm run build:angular && npm run build:electron && electron-builder"
  },
  "private": true,
  "packageManager": "npm@11.14.1",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@libsql/client": "^0.17.4",
    "@lucide/angular": "^1.25.0",
    "better-sqlite3": "^13.0.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^1.0.0-rc.4",
    "electron-updater": "^6.8.9",
    "postcss": "^8.5.22",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.9",
    "@angular/cli": "^21.2.9",
    "@angular/compiler-cli": "^21.2.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/better-sqlite3": "^7.6.13",
    "@types/electron": "^1.4.38",
    "@types/node": "^26.1.1",
    "concurrently": "^10.0.3",
    "copyfiles": "^2.4.1",
    "drizzle-kit": "^1.0.0-rc.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8",
    "wait-on": "^9.1.0"
  }
}